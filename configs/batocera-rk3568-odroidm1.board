include batocera-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_a55=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_PACKAGE_BATOCERA_TARGET_RK3568=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
# NOT rk3568/patches: its ffmpeg/mpv patches add v4l2-request HEVC support
# that needs newer V4L2 UAPI structs only present in the shared target's
# mainline 7.0.11 kernel headers, not our BSP fork. Only the uboot patches
# from there are relevant to us, copied into our own patches dir instead.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/patches $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/rockchip/patches $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/rockchip/bsp-odroidm1/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/fsoverlay $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/rockchip/fsoverlay $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/rockchip/rk3568/fsoverlay"

# Kernel - our hardkernel BSP fork (HDMI+DSI dual livelock fix), not mainline
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/Pyohwan/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="fix-hdmi-dsi-dual-livelock"
BR2_KERNEL_HEADERS_6_1=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/rockchip/bsp-odroidm1/linux-defconfig.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Build the DTB from the kernel sources - in-tree DTS, odroid-m1 only
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3568-odroid-m1"

# Override the RK3568-family default board list (11 boards) - we only build odroid-m1
BR2_TARGET_BATOCERA_IMAGES_DEFINITIONS=y
BR2_TARGET_BATOCERA_IMAGES="rockchip/bsp-odroidm1"

# Bootloader
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_UBOOT_ODROID_M1=y

# fdtoverlay (host tool) - used by create-boot-script.sh to bake VU8M/i2c/spi overlays into the DTB
BR2_PACKAGE_HOST_DTC=y

# System
BR2_PACKAGE_BATOCERA_KODI21=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# GPU - Mali-G52 blob (hardkernel). The kernel also builds Panfrost as an
# unused module (matches the real device: loaded, refcount 0) but we use
# the proprietary blob, matching what's verified working on hardware.
BR2_PACKAGE_MALI_G52_ODROIDM1=y

# Enable Wayland - XWayland left off: the Mali-G52 blob only provides
# GLES/EGL (no desktop OpenGL), and XWayland pulls in several X11 games/
# tools that hard-depend on libgl (etlegacy, sonic-mania, supermodel,
# pcmanfm, ...), which fails buildroot's dependency-chain check outright.
BR2_PACKAGE_BATOCERA_WAYLAND_LABWC=y

# Firmware
BR2_PACKAGE_FIRMWARE_ARMBIAN=y

# choices can be put in _defconfig files only
BR2_PACKAGE_BATOCERA_SPLASH_MPV=y
